# Never commit a populated .env. Paper mode only in bootstrap.
TRADING_MODE=paper
BROKER=upstox
MONTHLY_CONTRIBUTION_INR=20000
# Credentials remain blank until their integration is implemented.
# Read-only, 1-year token (Developer Apps -> Analytics tab). Cannot place orders.
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
